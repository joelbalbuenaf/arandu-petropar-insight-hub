# Arandu con Claude. Sin esta variable, Arandu funciona en "modo demo" (sin IA, respuestas calculadas localmente).
ANTHROPIC_API_KEY=
# Acceso al Hub (sin estas dos variables el Hub queda abierto)
HUB_USUARIO=
HUB_CLAVE=
# Firma de la cookie de sesión (opcional; si falta se deriva de las credenciales)
HUB_SECRETO=
# Opcionales
ARANDU_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
ARANDU_EFFORT=medium
